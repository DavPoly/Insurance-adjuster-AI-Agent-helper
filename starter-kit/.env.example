# Copy to .env and fill in your own OpenRouter API key. Never commit .env.
OPENROUTER_API_KEY=
# OpenRouter's OpenAI-compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model route, e.g. openai/gpt-4o-mini or anthropic/claude-3.5-sonnet.
LLM_MODEL=
# Jev decision model used for the deterministic intake/safety checks. It
# reuses OPENROUTER_API_KEY above — no separate credential is required.
DECISION_MODEL=typesafe/jev-1.14
# OpenRouter Decisions API endpoint for the Jev decision model.
DECISION_ENDPOINT=https://openrouter.ai/api/alpha/decisions
